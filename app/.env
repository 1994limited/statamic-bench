# Bench environment: production-like, nothing cached at the response level.
APP_NAME=Bench
APP_ENV=production
APP_KEY=base64:YmVuY2gtYmVuY2gtYmVuY2gtYmVuY2gtYmVuY2gtYmU=
APP_DEBUG=false
APP_URL=http://bench.test
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=sqlite
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=array

STATAMIC_STACHE_WATCHER=false
STATAMIC_STATIC_CACHING_STRATEGY=null
STATAMIC_ANTLERS_DEBUGBAR=false
STATAMIC_GIT_ENABLED=false
STATAMIC_REVISIONS_ENABLED=false
STATAMIC_API_ENABLED=false
STATAMIC_GRAPHQL_ENABLED=false
STATAMIC_STACHE_PARALLEL_WARMING=false
CP_ENABLED=false

# multi-site needs Pro
STATAMIC_PRO_ENABLED=true
